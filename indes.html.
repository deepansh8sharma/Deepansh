<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Happy Birthday</title>
<style>
  :root{
    --ink: #150f28;
    --gold: #f4c14e;
    --gold-soft: #ffe3a3;
    --rose: #ff7aa2;
    --cream: #fff6e9;
    --violet: #8a5cf6;
    --mint: #6fe7c8;
    --box: #d94f6b;
    --box-lid: #ff8fae;
  }

  *{ box-sizing: border-box; margin:0; padding:0; }

  html,body{
    height:100%;
    background: linear-gradient(135deg, #241546, #150f28 55%, #1c1030);
    background-size: 300% 300%;
    animation: bgDrift 14s ease infinite;
    overflow:hidden;
    font-family: 'Segoe UI', system-ui, sans-serif;
  }
  @keyframes bgDrift{
    0%{ background-position: 0% 50%; }
    50%{ background-position: 100% 50%; }
    100%{ background-position: 0% 50%; }
  }

  .stage{
    position:relative;
    width:100vw;
    height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
  }

  canvas#fx{
    position:absolute; inset:0;
    z-index: 12;
    pointer-events:none;
  }

  .stars{
    position:absolute;
    inset:0;
    background-image:
      radial-gradient(1.5px 1.5px at 20% 30%, #fff8 50%, transparent 60%),
      radial-gradient(1.5px 1.5px at 70% 20%, #fff6 50%, transparent 60%),
      radial-gradient(1px 1px at 40% 70%, #fff5 50%, transparent 60%),
      radial-gradient(1.5px 1.5px at 85% 60%, #fff7 50%, transparent 60%),
      radial-gradient(1px 1px at 10% 80%, #fff5 50%, transparent 60%),
      radial-gradient(1.5px 1.5px at 60% 85%, #fff6 50%, transparent 60%),
      radial-gradient(1.5px 1.5px at 90% 15%, #fff6 50%, transparent 60%),
      radial-gradient(1px 1px at 30% 12%, #fff5 50%, transparent 60%);
    animation: twinkle 4s ease-in-out infinite alternate;
    z-index:1;
  }
  @keyframes twinkle{ from{opacity:.45;} to{opacity:1;} }

  /* ---------- Gate: gift box ---------- */
  .gate{
    position:relative;
    z-index:5;
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:22px;
    transition: opacity .5s ease, transform .5s ease;
    cursor:pointer;
  }
  .gate.hide{
    opacity:0;
    transform: scale(.8);
    pointer-events:none;
  }

  .prompt{
    color: var(--gold-soft);
    letter-spacing: .35em;
    font-size: 12px;
    text-transform: uppercase;
    opacity:.75;
  }

  .gift{
    position:relative;
    width:130px;
    height:110px;
    animation: giftBob 2s ease-in-out infinite;
  }
  @keyframes giftBob{ 0%,100%{ transform: translateY(0);} 50%{ transform: translateY(-8px);} }

  .gift-box{
    position:absolute;
    bottom:0; left:0;
    width:130px; height:80px;
    background: linear-gradient(160deg, var(--box), #b7365a);
    border-radius: 6px;
    box-shadow: 0 18px 30px -10px #000a;
  }
  .gift-lid{
    position:absolute;
    top:16px; left:-8px;
    width:146px; height:26px;
    background: linear-gradient(160deg, var(--box-lid), var(--box));
    border-radius: 6px;
    transform-origin: 50% 100%;
    transition: transform .5s cubic-bezier(.3,1.6,.5,1), opacity .4s ease .1s;
    z-index:2;
  }
  .gift.open .gift-lid{
    transform: rotate(-100deg) translateY(-10px);
    opacity:0;
  }
  .ribbon-v{
    position:absolute;
    top:0; left:50%;
    width:16px; height:100%;
    background: var(--gold-soft);
    transform: translateX(-50%);
  }
  .bow{
    position:absolute;
    top:-14px; left:50%;
    transform: translateX(-50%);
    width:40px; height:24px;
  }
  .bow::before, .bow::after{
    content:'';
    position:absolute;
    top:0;
    width:20px; height:20px;
    background: var(--gold);
    border-radius: 50% 50% 50% 0;
  }
  .bow::before{ left:0; transform: rotate(45deg); }
  .bow::after{ right:0; transform: rotate(-45deg) scaleX(-1); }

  .hint-arrow{
    font-size: 20px;
    color: var(--rose);
    animation: bob 1.6s ease-in-out infinite;
  }
  @keyframes bob{ 0%,100%{transform:translateY(0);} 50%{transform:translateY(8px);} }

  /* ---------- Scene ---------- */
  .scene{
    position:absolute;
    inset:0;
    display:flex;
    align-items:center;
    justify-content:center;
    opacity:0;
    pointer-events:none;
  }
  .scene.play{ opacity:1; pointer-events:auto; }

  .flash{
    position:absolute; inset:0;
    background: var(--cream);
    opacity:0;
    z-index:20;
  }
  .scene.play .flash{
    animation: flashPop .55s ease-out forwards;
  }
  @keyframes flashPop{
    0%{ opacity:0; }
    14%{ opacity:1; }
    100%{ opacity:0; }
  }

  .content{
    position:relative;
    z-index:10;
    display:flex;
    flex-direction:column;
    align-items:center;
    text-align:center;
  }

  .balloons{
    position:absolute;
    bottom:-40px;
    width:100%;
    height:100%;
    z-index:6;
    pointer-events:none;
  }
  .balloon{
    position:absolute;
    bottom:-160px;
    width:60px;
    height:76px;
    border-radius:50% 50% 50% 50% / 60% 60% 40% 40%;
    opacity:0;
  }
  .balloon::after{
    content:'';
    position:absolute;
    left:50%; top:100%;
    width:2px; height:65px;
    background: rgba(255,255,255,.35);
    transform: translateX(-50%);
  }
  .scene.play .balloon{ animation: floatUp 4.4s ease-in forwards; }
  @keyframes floatUp{
    0%{ opacity:0; transform: translateY(0) translateX(0) rotate(0deg); }
    6%{ opacity:1; }
    100%{ opacity:0; transform: translateY(-120vh) translateX(var(--drift)) rotate(var(--rot)); }
  }
  .b1{ left:8%;  background: var(--rose);   animation-delay:1.1s !important; --drift:30px;  --rot:8deg; }
  .b2{ left:20%; background: var(--gold);   animation-delay:1.4s !important; --drift:-25px; --rot:-6deg; width:52px; height:66px;}
  .b3{ left:72%; background: var(--violet); animation-delay:1s   !important; --drift:-35px; --rot:-10deg; }
  .b4{ left:84%; background: var(--rose);   animation-delay:1.55s !important; --drift:20px; --rot:6deg; width:46px; height:60px;}
  .b5{ left:48%; background: var(--mint);   animation-delay:1.25s !important; --drift:15px; --rot:5deg; width:56px; height:70px;}
  .b6{ left:2%;  background: var(--mint);   animation-delay:4.4s !important; --drift:25px;  --rot:7deg; width:50px; height:64px;}
  .b7{ left:92%; background: var(--violet); animation-delay:4.6s !important; --drift:-20px; --rot:-8deg; width:54px; height:68px;}

  /* Cake */
  .cake-wrap{
    position:relative;
    transform: scale(0);
    opacity:0;
  }
  .scene.play .cake-wrap{
    animation: cakePop .7s cubic-bezier(.2,1.4,.4,1) 1.6s forwards;
  }
  @keyframes cakePop{
    0%{ transform: scale(0) translateY(40px); opacity:0; }
    100%{ transform: scale(1) translateY(0); opacity:1; }
  }

  .candles{
    display:flex;
    justify-content:center;
    gap: 22px;
    margin-bottom:-4px;
  }
  .candle-unit{ position:relative; width:6px; }
  .flame{
    width:8px; height:16px;
    background: linear-gradient(to top, #ff7a1a, var(--gold) 60%, #fff2c2);
    border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
    margin: 0 auto;
    filter: drop-shadow(0 0 6px #ffb84d);
    opacity:0;
  }
  .scene.play .flame{ animation: flicker .3s ease-in-out infinite alternate, flameIn .3s ease var(--fin) forwards, flameOut .3s ease var(--fout) forwards; }
  .f1{ --fin: 2.3s; --fout: 5.0s; }
  .f2{ --fin: 2.45s; --fout: 5.4s; }
  .f3{ --fin: 2.6s; --fout: 5.8s; }
  @keyframes flicker{ 0%{ transform: scaleY(1) rotate(-2deg);} 100%{ transform: scaleY(1.15) rotate(2deg);} }
  @keyframes flameIn{ to{ opacity:1; } }
  @keyframes flameOut{ to{ opacity:0; transform: scaleY(0);} }

  .smoke{
    width:4px; height:4px;
    border-radius:50%;
    background: rgba(255,255,255,.5);
    margin: 0 auto;
    opacity:0;
  }
  .s1{ animation: smokeRise 1.3s ease-out 5.1s forwards; }
  .s2{ animation: smokeRise 1.3s ease-out 5.5s forwards; }
  .s3{ animation: smokeRise 1.3s ease-out 5.9s forwards; }
  .scene.play .smoke.s1{ animation-name: smokeRise; }
  @keyframes smokeRise{
    0%{ opacity:.7; transform: translateY(0) scale(1); }
    100%{ opacity:0; transform: translateY(-28px) scale(3); }
  }

  .candle{
    width:6px; height:24px;
    background: repeating-linear-gradient(45deg, var(--rose), var(--rose) 4px, var(--cream) 4px, var(--cream) 8px);
    margin: 0 auto;
    border-radius:2px;
  }

  .cake{ width:200px; }
  .tier{
    width:100%;
    border-radius: 10px;
    box-shadow: inset 0 -6px 0 rgba(0,0,0,.12), 0 8px 18px -6px #0007;
  }
  .tier1{ height:26px; background: var(--violet); border-radius: 12px 12px 6px 6px;}
  .tier2{ height:46px; background: linear-gradient(180deg, var(--rose), #ff5c8a); margin-top:-4px; }
  .plate{ height:8px; width:115%; margin-left:-7.5%; background: var(--gold-soft); border-radius:50%; margin-top:-2px;}

  .drip{
    height:10px;
    background: repeating-radial-gradient(circle at 10px -2px, var(--gold-soft) 0 5px, transparent 6px 20px);
    margin-top:-6px;
  }

  .wish-line{
    margin-top:16px;
    color: var(--gold-soft);
    letter-spacing:.2em;
    font-size:11px;
    text-transform:uppercase;
    opacity:0;
  }
  .scene.play .wish-line{
    animation: riseIn .5s ease 2.4s forwards, fadeOut .4s ease 4.7s forwards;
  }
  @keyframes fadeOut{ to{ opacity:0; } }

  .msg{
    margin-top: 24px;
    min-height: 100px;
  }
  .msg-line{
    opacity:0;
    transform: translateY(14px);
    font-family: Georgia, 'Times New Roman', serif;
  }
  .msg-line.big{
    font-style: italic;
    font-size: clamp(30px, 6vw, 52px);
    background: linear-gradient(135deg, var(--gold-soft), var(--gold) 45%, var(--rose));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .msg-line.small{
    margin-top:10px;
    font-family: 'Segoe UI', system-ui, sans-serif;
    font-style:normal;
    color: #e8ddff;
    letter-spacing:.14em;
    font-size: 13px;
    text-transform: uppercase;
    opacity:0;
  }
  .scene.play #line1{ animation: riseIn .6s ease 5.3s forwards; }
  .scene.play #line2{ animation: riseIn .6s ease 6.2s forwards; }
  .scene.play #line3{ animation: riseIn .6s ease 7.0s forwards; }
  @keyframes riseIn{ to{ opacity:1; transform:translateY(0);} }

  .confetti-piece{
    position:absolute;
    top:-5%;
    width:8px; height:14px;
    opacity:0;
    z-index:15;
  }
  .scene.play .confetti-piece{
    animation-name: confettiFall;
    animation-timing-function: cubic-bezier(.25,.46,.45,.94);
    animation-fill-mode: forwards;
  }
  @keyframes confettiFall{
    0%{ opacity:0; transform: translateY(0) rotate(0deg); }
    5%{ opacity:1; }
    100%{ opacity:.9; transform: translateY(112vh) rotate(540deg); }
  }

  /* Ambient glitter that runs the whole scene */
  .glitter{
    position:absolute;
    border-radius:50%;
    background: var(--gold-soft);
    opacity:0;
    z-index:3;
  }
  .scene.play .glitter{
    animation-name: glitterDrift;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }
  @keyframes glitterDrift{
    0%{ opacity:0; transform: translateY(0); }
    10%{ opacity:.9; }
    90%{ opacity:.9; }
    100%{ opacity:0; transform: translateY(-100vh); }
  }

  @media (prefers-reduced-motion: reduce){
    *{ animation-duration: .01ms !important; animation-iteration-count: 1 !important; }
  }
</style>
</head>
<body>

<div class="stage">
  <div class="stars"></div>
  <canvas id="fx"></canvas>

  <div class="gate" id="gate">
    <div class="prompt">A little something for you</div>
    <div class="gift" id="gift">
      <div class="gift-lid"><div class="bow"></div></div>
      <div class="gift-box"><div class="ribbon-v"></div></div>
    </div>
    <div class="hint-arrow">tap the gift ✦</div>
  </div>

  <div class="scene" id="scene">
    <div class="flash"></div>
    <div class="glitter-holder" id="glitter"></div>
    <div class="balloons" id="balloons">
      <div class="balloon b1"></div>
      <div class="balloon b2"></div>
      <div class="balloon b3"></div>
      <div class="balloon b4"></div>
      <div class="balloon b5"></div>
      <div class="balloon b6"></div>
      <div class="balloon b7"></div>
    </div>
    <div class="confetti-holder" id="confetti"></div>
    <div class="confetti-holder" id="confetti2"></div>

    <div class="content">
      <div class="cake-wrap">
        <div class="candles">
          <div class="candle-unit"><div class="flame f1"></div><div class="smoke s1"></div><div class="candle"></div></div>
          <div class="candle-unit"><div class="flame f2"></div><div class="smoke s2"></div><div class="candle"></div></div>
          <div class="candle-unit"><div class="flame f3"></div><div class="smoke s3"></div><div class="candle"></div></div>
        </div>
        <div class="cake">
          <div class="tier tier1"></div>
          <div class="drip"></div>
          <div class="tier tier2"></div>
          <div class="plate"></div>
        </div>
      </div>
      <div class="wish-line">Make a wish...</div>

      <div class="msg">
        <div class="msg-line big" id="line1">Happy Birthday</div>
        <div class="msg-line small" id="line2">Another year, another reason to celebrate you</div>
        <div class="msg-line small" id="line3">Wishing you joy, cake &amp; everything nice ✨</div>
      </div>
    </div>
  </div>
</div>

<script>
  const gate = document.getElementById('gate');
  const gift = document.getElementById('gift');
  const scene = document.getElementById('scene');
  const confettiHolder = document.getElementById('confetti');
  const confettiHolder2 = document.getElementById('confetti2');
  const glitterHolder = document.getElementById('glitter');

  function spawnConfetti(holder, count, delayBase){
    holder.innerHTML = '';
    const colors = ['#f4c14e','#ff7aa2','#8a5cf6','#ffe3a3','#ff5c8a','#6fe7c8'];
    for(let i=0;i<count;i++){
      const p = document.createElement('div');
      p.className = 'confetti-piece';
      p.style.left = (Math.random()*100) + '%';
      p.style.background = colors[Math.floor(Math.random()*colors.length)];
      p.style.borderRadius = Math.random() > .5 ? '50%' : '2px';
      p.style.animationDelay = (delayBase + Math.random()*1.4) + 's';
      p.style.animationDuration = (Math.random()*1.6 + 2.3) + 's';
      holder.appendChild(p);
    }
  }

  function spawnGlitter(){
    glitterHolder.innerHTML = '';
    for(let i=0;i<26;i++){
      const g = document.createElement('div');
      g.className = 'glitter';
      const size = Math.random()*3 + 1.5;
      g.style.width = size + 'px';
      g.style.height = size + 'px';
      g.style.left = (Math.random()*100) + '%';
      g.style.bottom = '-10px';
      g.style.animationDuration = (Math.random()*6 + 6) + 's';
      g.style.animationDelay = (Math.random()*6) + 's';
      glitterHolder.appendChild(g);
    }
  }

  /* ---------- Canvas fireworks ---------- */
  const canvas = document.getElementById('fx');
  const ctx = canvas.getContext('2d');
  function resize(){ canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
  resize();
  window.addEventListener('resize', resize);

  let particles = [];
  const fwColors = ['#f4c14e','#ff7aa2','#8a5cf6','#ffe3a3','#6fe7c8','#ff5c8a'];

  function burst(x, y){
    const count = 46;
    const color = fwColors[Math.floor(Math.random()*fwColors.length)];
    for(let i=0;i<count;i++){
      const angle = (Math.PI*2*i)/count;
      const speed = Math.random()*3.2 + 1.6;
      particles.push({
        x, y,
        vx: Math.cos(angle)*speed,
        vy: Math.sin(angle)*speed,
        life: 1,
        decay: Math.random()*0.012 + 0.01,
        color,
        size: Math.random()*2 + 1.5
      });
    }
  }

  function animate(){
    ctx.clearRect(0,0,canvas.width,canvas.height);
    particles.forEach(p => {
      p.x += p.vx;
      p.y += p.vy;
      p.vy += 0.035; /* gravity */
      p.vx *= 0.99;
      p.life -= p.decay;
    });
    particles = particles.filter(p => p.life > 0);
    particles.forEach(p => {
      ctx.globalAlpha = Math.max(p.life, 0);
      ctx.fillStyle = p.color;
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.size, 0, Math.PI*2);
      ctx.fill();
    });
    ctx.globalAlpha = 1;
    requestAnimationFrame(animate);
  }
  animate();

  function fireworksShow(){
    const w = canvas.width, h = canvas.height;
    const spots = [
      [w*0.28, h*0.28], [w*0.72, h*0.24], [w*0.5, h*0.35], [w*0.18, h*0.42], [w*0.84, h*0.4]
    ];
    spots.forEach((pt, i) => {
      setTimeout(() => burst(pt[0], pt[1]), i * 260);
    });
  }

  /* ---------- Sequence ---------- */
  function openGift(){
    gift.classList.add('open');
    setTimeout(() => {
      gate.classList.add('hide');
      spawnConfetti(confettiHolder, 55, 0.2);
      spawnConfetti(confettiHolder2, 45, 4.6);
      spawnGlitter();
      scene.classList.add('play');
      fireworksShow();
      setTimeout(fireworksShow, 3600);
    }, 550);
  }

  gift.addEventListener('click', openGift, { once: true });
</script>

</body>
</html>
